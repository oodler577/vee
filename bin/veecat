#!/bin/sh
# Extract fields from vee raw posts; filenames arrive one per line on stdin.
set -eu
TITLE=0 DATE=0 BODY=0 ALL=0
while getopts 'abdt' option; do
  case $option in
    a) ALL=1;; b) BODY=1;; d) DATE=1;; t) TITLE=1;; *) exit 2;;
  esac
done
if [ -f ./.veerc ]; then . ./.veerc; fi
if [ "$TITLE$DATE$BODY" = 111 ]; then ALL=1; fi
while IFS= read -r file || [ -n "$file" ]; do
  [ -f "$file" ] || continue
  case $file in /*|./*|../*) ;; *) file=./$file;; esac
  if [ "$ALL" = 1 ]; then
    cat "$file"
  else
    if [ "$TITLE" = 1 ]; then sed -n '3p' "$file"; fi
    if [ "$DATE" = 1 ]; then sed -n '1p' "$file"; fi
    if [ "$BODY" = 1 ]; then tail -n +7 "$file"; fi
  fi
done
