 html_escape()
{
  printf '%s' "$1" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

 default_update_html_index()
{
  cp "$INDEX" "$WORK/index"
  printf '<!-- ;%s; -->%s:<a href="%s"> %s</a>\n' "$SEC" "$PUBLISHED" "$(html_escape "$1")" "$(html_escape "$3")" >> "$WORK/index"
  if [ -n "$SUMMARY" ]; then
    printf '<!-- ;%s; -->%s\n' "$((SEC - 1))" "$SUMMARY" >> "$WORK/index"
  fi
  sort -t';' -nr -k2,2 "$WORK/index" > "$WORK/index.sorted"
  mv "$WORK/index.sorted" "$INDEX"
}

 default_update_gophermap()
{
  _MAP="$WORK/gophermap"
  printf '%s\n\n' "$GOPHERMAP_HEADER" > "$_MAP"
  veels -d "$DIR" -e "$RAWEXT" > "$WORK/list-gopher"
  while IFS= read -r _RAW; do
    _BASE=${_RAW%.*}
    [ -f "$_BASE.$GOPHER_FORMAT" ] || continue
    _TITLE=$(printf '%s\n' "$_RAW" | veecat -t)
    _DATE=$(printf '%s\n' "$_RAW" | veecat -d | awk '{print $3 " " $2 " " $6}')
    _FILE=${_BASE##*/}.$GOPHER_FORMAT
    printf '0[%s] %s\tphlogsrc/%s\n' "$_DATE" "$_TITLE" "$_FILE" >> "$_MAP"
  done < "$WORK/list-gopher"
  if [ ! -e phlogsrc ] && [ ! -L phlogsrc ]; then
    ln -s "$DIR" phlogsrc
  fi
  printf '\n%s\n\nGenerated with vee.\n' "$GOPHERMAP_FOOTER" >> "$_MAP"
  mv "$_MAP" "$GOPHERMAP"
}

 #"$FINAL" "$gFINAL" "$RAW" "$gRAW" "$TITLE"
 default_update_index()
{
  if [ 2 != $GOPHERMODE ]; then
    default_update_html_index "$1" "$3" "$5"
  fi
  if [ 0 != $GOPHERMODE ]; then
    default_update_gophermap  "$2" "$4" "$5"
  fi
}

 output_top()
{ printf '%s\n' "$HEADERTXT"          > "$FINAL"
  if [ -e "$TOP_TPL" ]; then
     cat "$TOP_TPL"         >> "$FINAL"
   else
     printf '%s\n' "<!-- <?xml version=\"1.0\" encoding=\"UTF-8\" ?> --><!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\"><html xmlns=\"http://www.w3.org/1999/xhtml\">"  >> "$FINAL"
     printf '%s\n' "<meta http-equiv=\"Content-Type\" CONTENT=\"text/html; charset=UTF-8\">"                     >> "$FINAL"
     printf '%s\n' "  <head><title>$(html_escape "$TITLE") - $DATE</title></head>"                                                >> "$FINAL"
     printf '%s\n' "  <body>"                                                                                    >> "$FINAL"
     printf '%s\n' "    <pre>"                                                                                   >> "$FINAL"
     printf '%s\n' "<a href=\"../$INDEX\">[index]</a><a href=\"./$RAWNAME\">[raw]</a><a href=\"../\">[main]</a>" >> "$FINAL"
   fi
   echo                   >> "$FINAL"
}

 output_bottom()
{ echo                   >> "$FINAL"
  echo --                >> "$FINAL"
  printf '%s\n' "$FOOTERTXT"      >> "$FINAL"
  if [ -e "$BOT_TPL" ]; then
    cat "$BOT_TPL"       >> "$FINAL"
  else
    printf '%s\n' "    </pre>"    >> "$FINAL"
    printf '%s\n' "  </body>"     >> "$FINAL"
    printf '%s\n' "</html>"       >> "$FINAL"
  fi
}

# begin formatting funcs

 format_with_groff()
{
  command -v groff >/dev/null 2>&1 || die_error "groff is not installed; use -f fmt, fold, or none"
  if [ "html" = "$_OUTPUT_TYPE" ]; then
    groff -man -Tascii "$RAW" > "$WORK/formatted"
    sed '/^$/N;/\n$/D' "$WORK/formatted" >> "$FINAL"
  else
    groff -man -Tascii "$gRAW" > "$WORK/formatted"
    sed '/^$/N;/\n$/D' "$WORK/formatted" > "$gFINAL"
  fi
}

 format_with_fmt()
{
  if [ "$MARGIN" -eq 0 ]; then with_no_formatting; return; fi
  if [ "html" = "$_OUTPUT_TYPE" ]; then
    fmt -w "$MARGIN" "$RAW" >> "$FINAL"
  else
    fmt -w "$MARGIN" "$gRAW" > "$gFINAL"
  fi
}

 format_with_fold()
{
  if [ "$MARGIN" -eq 0 ]; then with_no_formatting; return; fi
  if [ "html" = "$_OUTPUT_TYPE" ]; then
    fold -s -w "$MARGIN" "$RAW" >> "$FINAL"
  else
    fold -s -w "$MARGIN" "$gRAW" > "$gFINAL"
  fi
}

 with_no_formatting()
{
  if [ "html" = "$_OUTPUT_TYPE" ]; then
    cat "$RAW" >> "$FINAL"
  else
    cat "$gRAW" > "$gFINAL"
  fi
}

#
# preformat hook has been changed to NOT be a filter;
#
# $1 is 'html' or 'gopher'
#
 preformat()
{ if [ -x "$PREFORMAT_HOOK" ]; then
    "$PREFORMAT_HOOK" "$1"
  fi
}

#
# this hook is for any things to do after the post; a good example for use
# would be to integrate git or another SCM; another is a notification script
#
# $1 is 'html' or 'gopher'
#
 postformat()
{ if [ -x "$POSTFORMAT_HOOK" ]; then
    "$POSTFORMAT_HOOK" "$1"
  fi
}

# dispatches formatting based on $GOPHERMODE; sets $_OUTPUT_TYPE
# for called functions to know for what $_OUTPUT_TYPE they're doing stuff

 format_main_html()
{ FINAL=$DIR/$1
  FINALNAME=$1
  RAW=$DIR/$2
  RAWNAME=$2
  preformat $_OUTPUT_TYPE     # expecting 'html'
  if [ ! -e "$RAW" ]; then
    _RAW_TARGET=$RAW
    RAW="$WORK/new.raw"
    printf '%s\n' "$DATE"   > "$RAW"   # in RAW, line 1 is date
    echo          >> "$RAW"
    printf '%s\n' "$TITLE" >> "$RAW"   # in RAW, line 2 is title
    echo          >> "$RAW"
    printf '%s\n' "--"     >> "$RAW"
    echo          >> "$RAW"   # this blank line is important
    cat "$DRAFT"  >> "$RAW"
    mv "$RAW" "$_RAW_TARGET"
    RAW=$_RAW_TARGET
  fi
  _HTML_TARGET=$FINAL
  FINAL="$WORK/post.html"
  $OUTPUT_TOP
  $FORMAT_FUNC
  $OUTPUT_BOT
  mv "$FINAL" "$_HTML_TARGET"
  FINAL=$_HTML_TARGET
  postformat $_OUTPUT_TYPE    # expecting 'html'
}

 format_main_gopher()
{ gFINAL=$DIR/$1
  gFINALNAME=$1
  gRAW=$DIR/$2
  gRAWNAME=$2
  preformat $_OUTPUT_TYPE    # expecting 'gopher'
  if [ ! -e "$gRAW" ]; then
    _RAW_TARGET=$gRAW
    gRAW="$WORK/new.raw"
    printf '%s\n' "$DATE"   > "$gRAW" # in gRAW, line 1 is date
    echo          >> "$gRAW"
    printf '%s\n' "$TITLE" >> "$gRAW" # in gRAW, line 2 is title
    echo          >> "$gRAW"
    printf '%s\n' "--"     >> "$gRAW"
    echo          >> "$gRAW" # this blank line is important
    cat "$DRAFT"  >> "$gRAW"
    mv "$gRAW" "$_RAW_TARGET"
    gRAW=$_RAW_TARGET
  fi
  _GOPHER_TARGET=$gFINAL
  gFINAL="$WORK/post.txt"
  $OUTPUT_TOP_GOPHER         # NOTE: not set by default
  $FORMAT_FUNC
  $OUTPUT_BOT_GOPHER         # NOTE not set by default
  mv "$gFINAL" "$_GOPHER_TARGET"
  gFINAL=$_GOPHER_TARGET
  postformat $_OUTPUT_TYPE   # expecting 'gopher'
}

 format_main()
{ if [ 2 != $GOPHERMODE ]; then
    _OUTPUT_TYPE=html     # tracks formatting type
    format_main_html "$1" "$3"
  fi

  if [ 0 != $GOPHERMODE ]; then
    _OUTPUT_TYPE=gopher  # tracks formatting type
    format_main_gopher "$2" "$3"
  fi
  _OUTPUT_TYPE=none
}

 refresh_html_title()
{
  if [ "$GOPHERMODE" != 2 ] && [ -f "$INDEX" ]; then
    _HREF="<a href=\"$(html_escape "$DIR/$1.$FORMAT")\">"
    _OLD_HREF="<a href=\"$(html_escape "${DIR#./}/$1.$FORMAT")\">"
    # Pass replacement through a file so awk does not interpret title backslashes.
    printf '%s' "$(html_escape "$TITLE")" > "$WORK/title"
    awk -v href="$_HREF" -v oldhref="$_OLD_HREF" -v titlefile="$WORK/title" '
      BEGIN { getline title < titlefile; close(titlefile) }
      { active=href; start=index($0,active); if(!start) { active=oldhref; start=index($0,active) } if(start) {
          rest=substr($0,start+length(active)); finish=index(rest,"</a>");
          if(finish) $0=substr($0,1,start+length(active)-1) " " title substr(rest,finish)
        } print }' "$INDEX" > "$WORK/index.edited"
    mv "$WORK/index.edited" "$INDEX"
  fi
}

 reformat_singleton()
{  if [ -e "$DIR/$1.$RAWEXT" ]; then
     DATE=$(head -n 1 "$DIR/$1.$RAWEXT")
     TITLE=$(sed -n '3p' "$DIR/$1.$RAWEXT")
     cat "$DIR/$1.$RAWEXT" > "$DRAFT"
     format_main "$1.$FORMAT" "$1.$GOPHER_FORMAT" "$1.$RAWEXT"
     refresh_html_title "$1"
   fi
}

 reformat_all()
{
   veels -d "$DIR" -e "$RAWEXT" -r > "$WORK/list"
   while IFS= read -r f; do
     # From: Randall R Schulz <rrschulz at cris dot com>
     FULLNAME="$f"
     DIR=${FULLNAME%/*}
     FILE=${FULLNAME##*/}
     MAXBASE=${FILE%.*}
     MINBASE=${FILE%%.*}
     MAXSUF=${FILE#*.}
     MINSUF=${FILE##*.}
     _TITLE=$(printf '%s\n' "$f" | veecat -t)
     printf '%s\n' "..reformatting '$_TITLE'"
     reformat_singleton "$MAXBASE"
   done < "$WORK/list"
}

 list_newest_first()
{ COUNT=1
  veels -d "$DIR" -e "$RAWEXT" > "$WORK/list"
  while IFS= read -r _RAW; do
    _TITLE=$(printf '%s\n' "$_RAW" | veecat -t)
    _DATE=$(printf '%s\n' "$_RAW" | veecat -d)
    printf "%4d)  " "$COUNT"
    printf '%s - %s\n' "$_DATE" "$_TITLE"
    COUNT=$((COUNT + 1))
  done < "$WORK/list"
}

 list_oldest_first()
{ COUNT=1
  veels -d "$DIR" -e "$RAWEXT" -r > "$WORK/list"
  while IFS= read -r _RAW; do
    _TITLE=$(printf '%s\n' "$_RAW" | veecat -t)
    _DATE=$(printf '%s\n' "$_RAW" | veecat -d)
    printf "%4d)  " "$COUNT"
    printf '%s - %s\n' "$_DATE" "$_TITLE"
    COUNT=$((COUNT + 1))
  done < "$WORK/list"
}

 get_path2post()
{
  GOAL=$1
  COUNT=1
  veels -d "$DIR" -e "$RAWEXT" > "$WORK/list"
  while IFS= read -r FILE; do
     FULLNAME=$FILE
     DIR=${FULLNAME%/*}
     FILE=${FULLNAME##*/}
     MAXBASE=${FILE%.*}
     if [ "$COUNT" -eq "$GOAL" ]; then
       printf '%s\n' "$MAXBASE"
       break
      fi
      COUNT=$((COUNT + 1))
  done < "$WORK/list"
}

 purge_entries()
{ LEVEL=$1
  COUNT=0
  _PURGE_INDEX=$INDEX
  _PURGE_EXT=$FORMAT
  if [ "$GOPHERMODE" = 2 ]; then
    _PURGE_INDEX=$GOPHERMAP
    _PURGE_EXT=$GOPHER_FORMAT
  fi
  [ -f "$_PURGE_INDEX" ] || die_error "cannot find publication index: $_PURGE_INDEX"
  veels -d "$DIR" -e "$RAWEXT" > "$WORK/list"
  while IFS= read -r FILE; do
     FULLNAME=$FILE
     DIR=${FULLNAME%/*}
     FILE=${FULLNAME##*/}
     MAXBASE=${FILE%.*}
     ENTRY=$(grep -F "$MAXBASE.$_PURGE_EXT" "$_PURGE_INDEX" || :)
     if [ -z "$ENTRY" ]; then
       COUNT=$(expr "$COUNT" + 1)
       if [ "$LEVEL" -eq 1 ]; then
         printf '%s\n' "$DIR/$FILE (not really purged, use -P for realz)"
       elif [ "$LEVEL" -eq 2 ]; then
         printf '%s\n' "$DIR/${MAXBASE}[.$RAWEXT,$FORMAT] (delebed)"
         rm -f "$DIR/$MAXBASE.$RAWEXT" "$DIR/$MAXBASE.$FORMAT" "$DIR/$MAXBASE.$GOPHER_FORMAT"
       fi
     fi
  done < "$WORK/list"
  if [ "$LEVEL" -eq 1 ]; then
    printf '%s\n' "use -P to remove all $COUNT entrie(s)"
  elif [ "$LEVEL" -eq 2 ]; then
    printf '%s\n' "removed $COUNT entrie(s)..."
  fi
}

 die_error()
{
  printf 'vee: %s\n' "$*" >&2
  exit 1
}

 cleanup()
{
  if [ -n "${WORK:-}" ]; then rm -rf "$WORK"; fi
  if [ "${LOCKED:-0}" = 1 ]; then rmdir "$DIR/.vee.lock"; fi
}

 die_cleanly()
{
  exit 0
}

_POST2REFORMAT=0
_REFORMATALL=0
_PURGELEVEL=0
_POST2EDIT=0
SUMMARY=
MESSAGE=
SET_DEFAULT_FORMAT_FUNC=

# get opts ! stdin append to anything passed in by -m
while getopts 'DgGf:m:t:T:c:d:i:IbB:hRr:lL:novx:X:Pps:u:U' option; do
    case $option in
    u) _CUSTOM_UMASK=$OPTARG
       ;;
    U) _CUSTOM_UMASK=0022
       ;;
    D) set -x
       echo Setting debug mode with, set -x
       ;;
    g) # Gopher mode 1: output .txt and update $GOPHERMAP along side of HTML
       GOPHERMODE=1
       ;;
    G) # Gopher mode 2: treat as gopher phlog only (skip HTML stuff)
       GOPHERMODE=2
       ;;
    i) INDEX=$OPTARG  # specify INDEX to $OPTARG
       ;;
    I) INDEX="index.html" # force INDEX to index.html
       ;;
    d) if [ -d "$OPTARG" ]; then
         cd "$OPTARG" || die_error "cannot enter $OPTARG"
       else
         die_error "$OPTARG is not a directory"
       fi
       ;;
    r) _POST2REFORMAT=$OPTARG
       ;;
    R) _REFORMATALL=1
       ;;
    b) LISTENSTDIN=1
       USE_EDITOR=0
       ;;
    B) BOT_TPL=$OPTARG
       ;;
    f) SET_DEFAULT_FORMAT_FUNC=$OPTARG
       ;;
    c) MARGIN=$OPTARG
       ;;
    l) _POST2EDIT=1
       ;;
    L) _POST2EDIT=$OPTARG
       ;;
    m) MESSAGE=$OPTARG
       USE_EDITOR=0
       ;;
    n) _LIST=newest
       ;;
    o) _LIST=oldest
       ;;
    s) SUMMARY=$OPTARG
       ;;
    t) TITLE=$OPTARG
       ;;
    T) TOP_TPL=$OPTARG
       ;;
    v) echo $VERSION
       die_cleanly
       ;;
    p) _PURGELEVEL=1
       ;;
    P) _PURGELEVEL=2
       ;;
    h) usage
       die_cleanly
       ;;
    x) PREFORMAT_HOOK=$OPTARG
       ;;
    ?) die_error "invalid option or missing argument"
       ;;
    esac
done

 post_opts()
{
  if [ -n "$_CUSTOM_UMASK" ]; then
    umask "$_CUSTOM_UMASK"
  fi
  if [ $LISTENSTDIN -ne 1 ]; then
    # brute check for umask 0022 if not using -b ($LISTENSTDIN -eq 1)
    if [ "$(umask)" != "0022" ]; then
      _default=yes
      printf 'Would you like to temporarily set umask to 0022, to create files that are world readable [%s]?' "$_default"
      IFS= read -r tmp_set_umask || tmp_set_umask=no
      if [ -z "$tmp_set_umask" ]; then
        tmp_set_umask=$_default
      fi
      if [ "$tmp_set_umask" = "yes" ]; then
        echo
        umask 0022 && \
          echo OK. To avoid this message in the future use -U, set umask in your login environment, or set the _CUSTOM_UMASK variable in your ./.veerc.
      fi
    fi
  else
    : # Batch mode preserves the caller's umask unless explicitly overridden.
  fi

  if [ -e "$FORMAT_CUSTOM_DEFS" ]; then
    # shellcheck source=/dev/null
    . "$FORMAT_CUSTOM_DEFS"
  fi

  if [ -n "$SET_DEFAULT_FORMAT_FUNC" ]; then
    "$FORMAT_DISPATCHER" "$SET_DEFAULT_FORMAT_FUNC"  # default is set_format_func
  fi

  if [ "$_PURGELEVEL" -ge 1 ]; then
    purge_entries "$_PURGELEVEL"
    if [ "$_PURGELEVEL" = 2 ] && [ "$GOPHERMODE" != 0 ]; then
      default_update_gophermap
    fi
    die_cleanly
  fi

  if [ "$_POST2EDIT" -ge 1 ]; then
    LATEST=$(get_path2post "$_POST2EDIT")
    [ -n "$LATEST" ] || die_error "post does not exist"
    cp "$DIR/$LATEST.$RAWEXT" "$WORK/edit.raw"
    $EDITOR "$WORK/edit.raw"
    mv "$WORK/edit.raw" "$DIR/$LATEST.$RAWEXT"
    _POST2REFORMAT=$_POST2EDIT
  fi

  if [ "$_POST2REFORMAT" -ge 1 ]; then
    LATEST=$(get_path2post "$_POST2REFORMAT")
    [ -n "$LATEST" ] || die_error "post does not exist"
    reformat_singleton "$LATEST"
    if [ 0 != $GOPHERMODE ]; then
      default_update_gophermap
    fi
    die_cleanly
  fi

  # if "-R", or reformat all, is set
  if [ "$_REFORMATALL" -eq 1 ]; then
    # future may yield seperate "rebuild reindex" functionality
    reformat_all
    if [ 0 != $GOPHERMODE ]; then
      default_update_gophermap
    fi
    die_cleanly
  fi

  # blocks vee -l (without the -r) from going on
  if [ "$_POST2EDIT" -ge 1 ]; then
    die_cleanly
  fi

  # Batch message creation: -m and stdin
  # handles -m
  if [ -n "$MESSAGE" ]; then
    printf '%s\n' "$MESSAGE" >> "$DRAFT"
  fi

  if [ "$LISTENSTDIN" -eq 1 ]; then
    cat >> "$DRAFT"
  fi
}

# generates INDEX file if none exists
 default_setup_html()
{ if [ ! -e "$INDEX" ]; then
    echo
    printf '%s\n' "...creating $INDEX"
    printf '%s\n' "<!-- ;10000000000000000000000000; open pre tag --><!-- <?xml version=\"1.0\" encoding=\"UTF-8\" ?> --><!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\"><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>my vee index</title><meta http-equiv=\"Content-Type\" CONTENT=\"text/html; charset=UTF-8\"></head><body><pre>" >> "$INDEX"
   # header stuff
    printf '%s\n' "<!-- ;100000000000000000000000; fixed content -->" >> "$INDEX"
    printf '%s\n' "<!-- ;10000000000000000000000;  fixed content -->" >> "$INDEX"
    printf '%s\n' "<!-- ;1000000000000000000000;   fixed content -->" >> "$INDEX"
   # footer stuff
    printf '%s\n' "<!-- ;3; fixed content -->" >> "$INDEX"
    printf '%s\n' "<!-- ;2; fixed content -->" >> "$INDEX"
    printf '%s\n' "<!-- ;1; fixed content -->Powered by vee" >> "$INDEX"
    printf '%s\n' "<!-- ;0; closing pre tag --></pre></body></html>" >> "$INDEX"
    echo
  fi
}

 default_setup_gophermap()
{ if [ ! -e "$GOPHERMAP" ]; then
    echo
    printf '%s\n' "...generating updated $GOPHERMAP"
    echo $GOPHERMAP_HEADER > $GOPHERMAP
    echo                  >> $GOPHERMAP
    echo                  >> $GOPHERMAP
  fi
}

 default_setup()
{
  if [ 2 != $GOPHERMODE ]; then
    default_setup_html
  fi
  if [ 0 != $GOPHERMODE ]; then
    default_setup_gophermap
  fi
}

 use_editor()
{ if [ $USE_EDITOR -eq 1 ]; then
    OK=0
    $EDITOR "$DRAFT" && OK=1
    if [ "$OK" -ne 1 ]; then
      echo there has been a problem with your editor session
      exit 1
    fi
  #else
    #echo ...vi mode off
  fi
}

# ask for title if not set with -t and not in batch mode
# if in batch mode with no -t set, use default title below
 get_title()
{ if [ -z "$TITLE"  ]; then
    TITLE=$DEFAULT_TITLE
  fi
}

 read_config()
{ if [ -e ./.veerc ]; then
    . ./.veerc
  fi
}

# this case statement may be overkill if "sort -t';' -nr -k2,2" works across platforms
 sort_index()
{
  : # New entries are sorted atomically by default_update_html_index.
}

# Read configuration after -d; command-line values take precedence.
read_config
# Parse a second time to apply explicit command-line overrides after config.
OPTIND=1
while getopts 'DgGf:m:t:T:c:d:i:IbB:hRr:lL:novx:X:Pps:u:U' option; do
  case $option in
    g) GOPHERMODE=1;; G) GOPHERMODE=2;; i) INDEX=$OPTARG;; I) INDEX=index.html;;
    t) TITLE=$OPTARG;; s) SUMMARY=$OPTARG;; T) TOP_TPL=$OPTARG;; B) BOT_TPL=$OPTARG;;
    c) MARGIN=$OPTARG;; x) PREFORMAT_HOOK=$OPTARG;;
    u) _CUSTOM_UMASK=$OPTARG;; U) _CUSTOM_UMASK=0022;;
    *) :;; # Other options were handled during the first pass.
  esac
done
case $DIR in /*|./*|../*) ;; *) DIR=./$DIR;; esac
case $INDEX in /*|./*|../*) ;; *) INDEX=./$INDEX;; esac
case $GOPHERMAP in /*|./*|../*) ;; *) GOPHERMAP=./$GOPHERMAP;; esac
case $TITLE in
  *'
'*|*'	'*) die_error "title must be a single line without tabs";;
esac
case $MARGIN in ''|*[!0-9]*) die_error "invalid width: $MARGIN";; esac
for _NUMBER in "$_POST2EDIT" "$_POST2REFORMAT"; do
  case $_NUMBER in ''|*[!0-9]*) die_error "invalid post number: $_NUMBER";; esac
done
case $GOPHERMODE in 0|1|2) ;; *) die_error "invalid Gopher mode";; esac
[ ! -d "$INDEX" ] || die_error "index is a directory: $INDEX"
[ ! -d "$GOPHERMAP" ] || die_error "gophermap is a directory: $GOPHERMAP"
mkdir -p "$DIR"
mkdir "$DIR/.vee.lock" 2>/dev/null || die_error "blog is locked (another vee process or an interrupted run); inspect $DIR/.vee.lock"
LOCKED=1
WORK="$DIR/.vee.lock/work"
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir "$WORK"
DRAFT="$WORK/draft"
case ${_LIST:-} in
  newest) list_newest_first; exit 0;; oldest) list_oldest_first; exit 0;;
esac
post_opts
"$CUSTOM_SETUP"
get_title
use_editor

 main()
{ if [ -e "$DRAFT" ]; then
  RAWFILE="$SEC.$$.$TIME.$RAWEXT" # uses process id, $$, assuming there will
                                  # not be duplicate process ids within 1 sec of each other
  format_main "$SEC.$$.$TIME.$FORMAT" "$SEC.$$.$TIME.$GOPHER_FORMAT" "$RAWFILE"
  "$UPDATE_INDEX" "$FINAL" "$gFINAL" "$RAW" "$gRAW" "$TITLE"
  sort_index
  die_cleanly
else
  die_error "no post content"
fi
}

main
