#!/bin/sh
# Recover a default HTML index from raw post metadata. Output goes to stdout.
set -eu
DIR=.vee FORMAT=html
while getopts 'd:h' option; do
  case $option in
    d) cd "$OPTARG";;
    h) printf '%s\n' 'Usage: vee-rebuild [-d blog-directory] > recovered.html'; exit 0;;
    *) exit 2;;
  esac
done
if [ -f ./.veerc ]; then . ./.veerc; fi
[ -d "$DIR" ] || { printf 'vee-rebuild: not a directory: %s\n' "$DIR" >&2; exit 1; }
escape() { printf '%s' "$1" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'; }
printf '%s\n' '<!doctype html><html><head><meta charset="utf-8"><title>vee</title></head><body><pre>'
veels -d "$DIR" | while IFS= read -r file; do
  title=$(printf '%s\n' "$file" | veecat -t)
  date=$(printf '%s\n' "$file" | veecat -d)
  printf '%s <a href="%s">%s</a>\n' "$(escape "$date")" "$(escape "${file%.*}.$FORMAT")" "$(escape "$title")"
done
printf '%s\n' 'Powered by vee' '</pre></body></html>'
