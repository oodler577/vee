#!/bin/sh
# List raw post paths in timestamp order, one path per line.
set -eu
DIR=.vee EXT=raw REVERSE=0 STRIPEXT=0 USELS=0 LSOPTS=-lat
if [ -f ./.veerc ]; then . ./.veerc; fi
while getopts 'd:e:hlL:rx' option; do
  case $option in
    d) DIR=$OPTARG;; e) EXT=$OPTARG;; r) REVERSE=1;; x) STRIPEXT=1;;
    l) USELS=1;; L) USELS=1; LSOPTS=$OPTARG;;
    h) printf '%s\n' 'Usage: veels [-d directory] [-e extension] [-r] [-x] [-l|-L ls-options]'; exit 0;;
    *) exit 2;;
  esac
done
[ -d "$DIR" ] || { printf 'veels: not a directory: %s\n' "$DIR" >&2; exit 1; }
case $DIR in /*|./*|../*) ;; *) DIR=./$DIR;; esac
if [ "$REVERSE" = 1 ]; then ORDER=-n; else ORDER=-nr; fi
# Prefix the timestamp so directory names cannot affect ordering.
for file in "$DIR"/*."$EXT"; do
  [ -f "$file" ] || continue
  name=${file##*/}
  printf '%s\t%s\n' "${name%%.*}" "$file"
done | sort "$ORDER" | cut -f2- | while IFS= read -r file; do
  if [ "$USELS" = 1 ]; then
    # LSOPTS is intentionally a whitespace-separated option list.
    # shellcheck disable=SC2086
    ls $LSOPTS "$file"
  elif [ "$STRIPEXT" = 1 ]; then
    printf '%s\n' "${file%.*}"
  else
    printf '%s\n' "$file"
  fi
done
