#!/bin/sh
# Optional rsync/SSH publishing helper. Config is trusted shell code.
set -eu
VERBOSE=0 SERVER=
CONFIG=${VEE_PUBLISH_CONFIG:-"${HOME}/.veerc"}
if [ -f "$CONFIG" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG"
fi
usage() { printf '%s\n' 'Usage: vee-publish [-v] -s user@host:path'; }
while getopts 'hs:v' option; do
  case $option in
    h) usage; exit 0;; v) VERBOSE=1;; s) SERVER=$OPTARG;; *) usage >&2; exit 2;;
  esac
done
[ -n "$SERVER" ] || { printf '%s\n' 'vee-publish: no server specified' >&2; exit 1; }
command -v rsync >/dev/null 2>&1 || { printf '%s\n' 'vee-publish: rsync is required' >&2; exit 1; }
[ -n "${DIR:-}" ] && [ -d "$DIR" ] || { printf '%s\n' 'vee-publish: set DIR to the publication directory in ~/.veerc' >&2; exit 1; }
if [ "$VERBOSE" = 1 ]; then printf 'Publishing %s to %s\n' "$DIR" "$SERVER"; fi
# Include .vee: published HTML links depend on those files.
rsync -rlptuvPzh --stats --exclude='.vee.lock/' --exclude='.vee-recovery/' --exclude='.veerc' --exclude='.git/' -e ssh -- "$DIR/" "$SERVER"
