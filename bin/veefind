#!/bin/sh
# Recursive counterpart to veels. -M limits directory depth (default: 1).
set -eu
DIR=.vee EXT=raw DEPTH=1 REVERSE=0 STRIPEXT=0 FINDOPTS=
if [ -f ./.veerc ]; then . ./.veerc; fi
while getopts 'd:hF:M:rx' option; do
  case $option in
    d) cd "$OPTARG";; F) FINDOPTS=$OPTARG;; M) DEPTH=$OPTARG;;
    r) REVERSE=1;; x) STRIPEXT=1;;
    h) printf '%s\n' 'Usage: veefind [-d blog-directory] [-M depth] [-r] [-x] [-F find-options]'; exit 0;;
    *) exit 2;;
  esac
done
# Read the selected blog's config after changing directory.
if [ -f ./.veerc ]; then . ./.veerc; fi
case $DEPTH in ''|*[!0-9]*) printf '%s\n' 'veefind: invalid depth' >&2; exit 2;; esac
[ -d "$DIR" ] || { printf 'veefind: not a directory: %s\n' "$DIR" >&2; exit 1; }
case $DIR in /*|./*|../*) ;; *) DIR=./$DIR;; esac
if [ "$REVERSE" = 1 ]; then ORDER=-n; else ORDER=-nr; fi
# Filter depth ourselves: find -maxdepth is not a POSIX option.
# FINDOPTS is an explicitly requested, whitespace-separated find expression.
# shellcheck disable=SC2086
find "$DIR" -type f -name "*.$EXT" $FINDOPTS |
  awk -v root="$DIR/" -v depth="$DEPTH" '
    { relative=substr($0,length(root)+1); n=split(relative,parts,"/");
      if(n<=depth) { split(parts[n],stamp,"."); print stamp[1] "\t" $0 } }' |
  sort "$ORDER" | cut -f2- | while IFS= read -r file; do
    if [ "$STRIPEXT" = 1 ]; then file=${file%.*}; fi
    printf '%s\n' "$file"
  done
